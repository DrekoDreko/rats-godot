[node name="ShedYard" type="Node3D"]

[node name="Model" parent="." instance=ExtResource("1_mesh")]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("2_env")

; The yard used to be lit by a DirectionalLight plus a shadow-casting SpotLight.
; Both are gone on purpose: the scene is lit by the near-white ambient on the
; environment, and the lights here only add warm spots on top. A directional
; light would put a real gradient across every surface and a cast shadow would
; give the geometry a depth cue the reference look does not have.
[node name="StreetLamp" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.3, 4.82, 0.4)
light_color = Color(0.952941, 1, 0.8, 1)
light_specular = 0.0
light_energy = 1.0
omni_range = 7.0
omni_attenuation = 0.420448
